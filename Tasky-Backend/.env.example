# ── Application Environment ──────────────────────────────────
APP_NAME=Tasky
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated domains or * for mobile app
ALLOWED_ORIGINS=*
CORS_ORIGINS=*

# ── Database (PostgreSQL) ───────────────────────────────────
# e.g., postgresql+asyncpg://user:pass@host:5432/dbname or Render/Neon internal URL
DATABASE_URL=postgresql+asyncpg://tasky_user:tasky_password@localhost:5432/tasky_db

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=generate-a-secure-random-64-character-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── School LMS Synchronization ──────────────────────────────
DEFAULT_LMS_URL=https://my.smccnasipit.edu.ph
LMS_SYNC_INTERVAL_MINUTES=5
LMS_ENCRYPTION_KEY=generate-a-secure-32-character-encryption-key

# ── Redis / Background Queue ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Push Notifications ──────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=
