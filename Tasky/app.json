{
  "expo": {
    "name": "Tasky",
    "slug": "tasky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/TaskyFinal.png",
    "scheme": "tasky",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brian.tasky"
    },
    "android": {
      "package": "com.brian.tasky",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EFF6FF",
        "foregroundImage": "./assets/images/TaskyFinal.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/TaskyFinal.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/TaskyFinal.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "e8fc8a2c-69e3-4dc0-9b78-cf1f4c7e3ee3"
      }
    }
  }
}
